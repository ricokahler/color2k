{
  "name": "color2k",
  "version": "2.0.0",
  "description": "Fully dynamic colors in 2.4 kB. Parse, convert, adjust and mix CSS colors at runtime and check their contrast. Full sRGB coverage, no dependencies.",
  "homepage": "https://color2k.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/ricokahler/color2k.git"
  },
  "bugs": "https://github.com/ricokahler/color2k/issues",
  "license": "MIT",
  "author": {
    "name": "Rico Kahler",
    "email": "ricokahler@me.com",
    "url": "https://github.com/ricokahler"
  },
  "keywords": [
    "color",
    "colors",
    "css",
    "css-in-js",
    "color-parser",
    "color-manipulation",
    "hex",
    "rgb",
    "hsl",
    "darken",
    "lighten",
    "mix",
    "contrast",
    "wcag",
    "a11y",
    "theming",
    "typescript",
    "tiny",
    "tinycolor",
    "polished",
    "chroma-js"
  ],
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.main.cjs.js",
  "unpkg": "./dist/index.unpkg.umd.js",
  "jsdelivr": "./dist/index.unpkg.umd.js",
  "module": "./dist/index.module.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": [
      {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.exports.import.es.mjs",
        "default": "./dist/index.exports.require.cjs.js"
      },
      "./dist/index.exports.require.cjs.js"
    ],
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "build": "./scripts/build",
    "audit:prod": "npm audit --omit=dev",
    "check": "npm run lint && npm run color-map && npm test -- --coverage && npm run build && npm run compat:check && npm run docs:check && npm run examples:check && npm run website && npm run website:check && npm run pack:check && npm run audit:prod",
    "color-map": "node -r ./scripts/register.js ./scripts/color-map.ts",
    "compat:check": "node ./scripts/check-es2015.js && node ./scripts/check-node6.js",
    "docs:check": "CHECK_DOCS=1 node ./scripts/docs.js && node ./scripts/sizes.js --check && node ./scripts/readme-assets.js --check",
    "docs:generate": "node ./scripts/docs.js && node ./scripts/sizes.js && node ./scripts/readme-assets.js",
    "examples:check": "node ./scripts/check-examples.js",
    "lint": "eslint src --ext .ts,.js",
    "pack:check": "npm run build && node ./scripts/check-package.js",
    "prepare": "npm run build",
    "test": "jest",
    "website": "node ./scripts/website.js",
    "website:check": "node ./scripts/check-website.js"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/eslint-parser": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@babel/register": "7.29.7",
    "@eslint/js": "9.39.4",
    "@rollup/plugin-babel": "7.1.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@types/jest": "30.0.0",
    "acorn": "8.17.0",
    "eslint": "9.39.4",
    "jest": "30.4.2",
    "markdown-it": "14.3.0",
    "prettier": "3.9.4",
    "rollup": "4.62.2",
    "semantic-release": "25.0.5",
    "shiki": "4.3.1",
    "terser": "5.51.2",
    "typescript": "6.0.3"
  }
}
